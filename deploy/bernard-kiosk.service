# The TV side: a Wayland kiosk compositor running one Chromium window on the
# HDMI output, pointed at the display page.
#
# PAMName=login is what gives this service a logind session and therefore
# access to seat0 — the GPU and the display. Without it cage cannot open DRM.
#
# Install to /etc/systemd/system/bernard-kiosk.service

[Unit]
Description=Bernard TV kiosk
After=systemd-user-sessions.service bernard.service
Wants=bernard.service
Conflicts=getty@tty1.service
After=getty@tty1.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=kiosk
Group=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user

# XDG_RUNTIME_DIR is deliberately NOT set here. pam_systemd creates
# /run/user/<uid> for the session opened by PAMName=login and exports the
# variable into this service's environment. Setting it by hand with %U is the
# trap: that specifier is the UID of the service *manager* — 0 for a system
# unit — so it would point at root's runtime dir, which the kiosk user cannot
# write, and cage would fail to open its Wayland socket.
Environment=XDG_SESSION_TYPE=wayland
Environment=HOME=/home/kiosk
# A TV has no pointer, but plenty of USB keyboards expose a second HID
# interface that claims one, and cage then parks the default arrow in the middle
# of the screen. The page's `cursor: none` never applies, because with no mouse
# the pointer never moves and the browser never sees a pointer-enter event.
# This theme's shapes are all a 1x1 transparent pixel; install.sh writes it.
Environment=XCURSOR_THEME=blank
Environment=XCURSOR_SIZE=24
ExecStart=/usr/local/bin/bernard-kiosk

Restart=always
RestartSec=5

# Chromium needs its own namespaces for the renderer sandbox, so this unit is
# deliberately far less confined than bernard.service.
[Install]
WantedBy=graphical.target
