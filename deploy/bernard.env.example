# Bernard server configuration. Install to /etc/bernard/bernard.env (chmod 640,
# owned by root:bernard — it holds no secret today, but it will if you ever set
# BERNARD_DEV_PASSWORD).

# Where to listen. Keep it on all interfaces so people on the campus network can
# reach it directly; cloudflared connects to it over localhost either way.
BERNARD_ADDR=:8080

BERNARD_DATA_DIR=/var/lib/bernard

# ── Sign-in ───────────────────────────────────────────────────────────────────
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized JavaScript origins: your public URL, plus http://localhost:8080
# Only the client ID goes here. Google sign-in needs no client secret, so there
# is no secret to leak.
BERNARD_GOOGLE_CLIENT_ID=

# Who may submit. Leave empty to accept any Google account.
BERNARD_ALLOWED_DOMAINS=umd.edu,terpmail.umd.edu,startupshell.org

# Who may approve. Exact addresses, comma separated. Removing someone here
# takes effect on their next request.
BERNARD_ADMIN_EMAILS=you@startupshell.org

# Fallback used only when no Google client ID is set. Anyone who knows it gets
# admin, so it is for a laptop during setup, not for the NUC.
# BERNARD_DEV_PASSWORD=

# ── Limits and behavior ───────────────────────────────────────────────────────
BERNARD_MAX_UPLOAD_BYTES=268435456   # 256 MB
BERNARD_DEFAULT_DURATION_MS=10000
BERNARD_MAX_DURATION_MS=120000

# Hour (0-23, local time) at which the display page reloads itself. -1 disables.
BERNARD_DISPLAY_RELOAD_HOUR=4

# Set both of these once cloudflared is in front.
BERNARD_PUBLIC_URL=
BERNARD_TRUST_PROXY=false
